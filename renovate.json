{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "0 days",
  "automerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "schedule": ["at any time"],
  "automergeSchedule": ["at any time"],
  "dependencyDashboardApproval": false,
  "prCreation": "approval",
  "configMigration": false,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "branchConcurrentLimit": 0,
  "packageRules": [
    {
      "description": "Renovate only reads the repositories block of build.gradle (TerraformersMC, Shedaniel), so name the real registries for the other dependencies",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["net.fabricmc:fabric-loader", "net.fabricmc.fabric-api:fabric-api"],
      "registryUrls": ["https://maven.fabricmc.net/", "https://repo.maven.apache.org/maven2/"]
    },
    {
      "matchManagers": ["gradle"],
      "matchPackageNames": [
        "com.google.errorprone:error_prone_annotations",
        "org.junit.jupiter:junit-jupiter",
        "org.junit.platform:junit-platform-launcher",
        "net.sourceforge.pmd:pmd-java"
      ],
      "registryUrls": ["https://repo.maven.apache.org/maven2/"]
    },
    {
      "description": "com.mojang:minecraft is synthesized by Loom and is not published to any Maven repository",
      "matchManagers": ["gradle"],
      "matchPackageNames": ["com.mojang:minecraft"],
      "enabled": false
    },
    {
      "description": "Apply all eligible updates directly to the base branch without automatic pull requests",
      "matchPackageNames": ["*"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "schedule": ["at any time"],
      "automergeSchedule": ["at any time"],
      "minimumReleaseAge": "0 days",
      "dependencyDashboardApproval": false,
      "prCreation": "approval"
    },
    {
      "description": "Automerge lock file maintenance with an automatic PR fallback",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "platformAutomerge": false,
      "prCreation": "immediate",
      "dependencyDashboardApproval": false,
      "recreateWhen": "always",
      "pruneBranchAfterAutomerge": true
    },
    {
      "description": "Automerge pre-commit hooks with an automatic PR fallback",
      "matchManagers": ["pre-commit"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true,
      "platformAutomerge": false,
      "prCreation": "immediate",
      "dependencyDashboardApproval": false,
      "recreateWhen": "always",
      "pruneBranchAfterAutomerge": true
    }
  ],
  "vulnerabilityAlerts": {
    "prCreation": "approval"
  }
}
